@model AIResumeAnalyzer.MVC.Models.User
@{
    ViewData["Title"] = "History";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section DashboardStyles {
    <style>
        .history-header {
            margin-bottom: 30px;
        }

        .history-header h1 {
            font-size: 28px;
            margin-bottom: 6px;
            color: #1f2937;
        }

        .history-header p {
            color: #374151;
            margin-bottom: 20px;
        }

        /* TABS */
        .tabs-container {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            border-bottom: 2px solid rgba(255, 255, 255, 0.4);
            padding-bottom: 10px;
        }

        .tab-btn {
            background: rgba(255, 255, 255, 0.4);
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            color: #4b5563;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .tab-btn:hover {
            background: rgba(255, 255, 255, 0.7);
        }

        .tab-btn.active {
            background: linear-gradient(135deg, #6a5cff, #8b5cf6);
            color: #fff;
            box-shadow: 0 4px 10px rgba(106, 92, 255, 0.3);
        }

        /* TAB PANELS */
        .tab-panel {
            display: none;
            animation: fadeIn 0.4s ease-in-out;
        }

        .tab-panel.active {
            display: block;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* SHARED LIST STYLE */
        .history-list {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .history-card {
            background: rgba(255, 255, 255, 0.85);
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .history-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.1);
        }

        .card-info h4 {
            font-size: 18px;
            color: #1f2937;
            margin-bottom: 5px;
        }

        .card-info p {
            font-size: 14px;
            color: #6b7280;
            margin: 0;
        }
        
        .card-meta {
            display: flex;
            gap: 15px;
            margin-top: 8px;
            font-size: 13px;
        }
        
        .badge {
            padding: 4px 8px;
            border-radius: 6px;
            font-weight: 600;
        }
        
        .badge-score {
            background: #e0e7ff;
            color: #4338ca;
        }

        .badge-date {
            background: #f3f4f6;
            color: #4b5563;
        }

        .action-btn {
            padding: 8px 16px;
            border-radius: 8px;
            border: none;
            font-size: 14px;
            font-weight: 600;
            color: #fff;
            background: #6a5cff;
            cursor: pointer;
            transition: opacity 0.2s;
        }

        .action-btn:hover {
            opacity: 0.9;
        }
    </style>
}

<header class="history-header">
    <h1>Your History</h1>
    <p>Review your past resume analyses and mock interviews.</p>
</header>

<div class="tabs-container">
    <button class="tab-btn active" onclick="switchTab('resumeHistory')">Resume Uploads</button>
    <button class="tab-btn" onclick="switchTab('interviewHistory')">Interview Sessions</button>
</div>

<!-- Resume History Panel -->
<div id="resumeHistory" class="tab-panel active">
    <div class="history-list" id="resumeList">
        <p style="text-align:center; padding: 20px;">Loading your resumes...</p>
    </div>
</div>

<!-- Interview History Panel -->
<div id="interviewHistory" class="tab-panel">
    <div class="history-list" id="interviewList">
        <p style="text-align:center; padding: 20px;">Loading your interview sessions...</p>
    </div>
</div>

@section DashboardScripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            fetchResumes();
            fetchInterviews();
        });

        async function fetchResumes() {
            const list = document.getElementById('resumeList');
            try {
                const response = await fetch('/api/history/resumes');
                const data = await response.json();
                if (response.ok && data.success) {
                    renderResumes(data.data);
                } else {
                    list.innerHTML = '<p style="text-align:center; padding: 20px;">Error: ' + data.message + '</p>';
                }
            } catch (err) {
                list.innerHTML = '<p style="text-align:center; padding: 20px;">Connection error.</p>';
            }
        }

        async function fetchInterviews() {
            const list = document.getElementById('interviewList');
            try {
                const response = await fetch('/api/history/interviews');
                const data = await response.json();
                if (response.ok && data.success) {
                    renderInterviews(data.data);
                } else {
                    list.innerHTML = '<p style="text-align:center; padding: 20px;">Error: ' + data.message + '</p>';
                }
            } catch (err) {
                list.innerHTML = '<p style="text-align:center; padding: 20px;">Connection error.</p>';
            }
        }

        function renderResumes(resumes) {
            const list = document.getElementById('resumeList');
            if (resumes.length === 0) {
                list.innerHTML = '<p style="text-align:center; padding: 20px;">No resumes found. Try analyzing one!</p>';
                return;
            }

            let html = "";
            resumes.forEach(r => {
                html += '<div class="history-card" id="resume-' + r.id + '">' +
                    '<div class="card-info">' +
                        '<h4>' + r.originalFileName + '</h4>' +
                        '<div class="card-meta">' +
                            '<span class="badge badge-date">Analyzed: ' + new Date(r.uploadedAt).toLocaleDateString() + '</span>' +
                            '<span class="badge badge-score">Score: ' + r.atsScore + '/100</span>' +
                            '<span class="badge" style="background: #ecfdf5; color: #065f46;">' + r.detectedRole + '</span>' +
                        '</div>' +
                    '</div>' +
                    '<div style="display: flex; gap: 10px;">' +
                        '<button class="action-btn" onclick="viewResume(\'' + r.id + '\', \'' + r.detectedRole + '\')">View Details</button>' +
                        '<button class="action-btn" style="background: #ef4444;" onclick="deleteResume(\'' + r.id + '\')"><i class="fa-solid fa-trash"></i></button>' +
                    '</div>' +
                '</div>';
            });
            list.innerHTML = html;
        }

        function renderInterviews(sessions) {
            const list = document.getElementById('interviewList');
            if (sessions.length === 0) {
                list.innerHTML = '<p style="text-align:center; padding: 20px;">No interview sessions found.</p>';
                return;
            }

            let html = "";
            sessions.forEach(s => {
                html += '<div class="history-card" id="interview-' + s.id + '">' +
                    '<div class="card-info">' +
                        '<h4>' + s.detectedRole + ' Mock</h4>' +
                        '<p>Questions: ' + s.qnAs.length + '</p>' +
                        '<div class="card-meta">' +
                            '<span class="badge badge-date">Date: ' + new Date(s.startedAt).toLocaleDateString() + '</span>' +
                            '<span class="badge badge-score">Score: ' + s.finalScore + '/100</span>' +
                        '</div>' +
                    '</div>' +
                    '<div style="display: flex; gap: 10px;">' +
                        '<button class="action-btn" style="background: #ef4444;" onclick="deleteInterview(\'' + s.id + '\')"><i class="fa-solid fa-trash"></i></button>' +
                    '</div>' +
                '</div>';
            });
            list.innerHTML = html;
        }

        function viewResume(id, role) {
            localStorage.setItem("lastResumeId", id);
            localStorage.setItem("detectedRole", role);
            window.location.href = "/resume-analyze";
        }

        async function deleteResume(id) {
            if (!confirm("Are you sure you want to delete this resume?")) return;
            try {
                const response = await fetch('/api/history/resume/' + id, { method: 'DELETE' });
                if (response.ok) document.getElementById('resume-' + id).remove();
            } catch (err) { alert("Failed to delete."); }
        }

        async function deleteInterview(id) {
            if (!confirm("Are you sure you want to delete this session?")) return;
            try {
                const response = await fetch('/api/history/interview/' + id, { method: 'DELETE' });
                if (response.ok) document.getElementById('interview-' + id).remove();
            } catch (err) { alert("Failed to delete."); }
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.remove('active'));
            event.target.classList.add('active');
            document.getElementById(tabId).classList.add('active');
        }
    </script>
}
