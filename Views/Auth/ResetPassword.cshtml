@{
    ViewData["Title"] = "New Password";
}

@section Styles {
    <link rel="stylesheet" href="~/css/LoginForm.css" asp-append-version="true" />
}

<div class="login-container">
    <div class="auth-wrapper">
        <div class="brand-section">
            <h1 class="brand-name">Orbit AI</h1>
            <p class="brand-tagline">Navigating your career path.</p>
        </div>

        <div class="login-form">
            <h2 class="form-title">Set New Password</h2>
            <p class="form-subtitle">
                Please enter a secure new password for your account.
            </p>

            <label>
                New Password
                <input
                    type="password"
                    id="newPassword"
                    placeholder="••••••••"
                    required />
            </label>

            <label>
                Confirm Password
                <input
                    type="password"
                    id="confirmPassword"
                    placeholder="••••••••"
                    required />
            </label>

            <button type="button" id="resetBtn">
                Update Password
            </button>

            <div id="message" style="margin-top: 10px; text-align: center; font-size: 0.9em;"></div>

            <div class="form-footer" style="margin-top: 15px;">
                <a href="/">← Back to Login</a>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('resetBtn').onclick = async () => {
        const phone = "@ViewBag.Phone";
        const code = "@ViewBag.Code";
        const newPassword = document.getElementById('newPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        const msg = document.getElementById('message');

        if (newPassword !== confirmPassword) {
            msg.style.color = "red";
            msg.innerText = "Passwords do not match.";
            return;
        }

        if (newPassword.length < 6) {
            msg.style.color = "red";
            msg.innerText = "Password must be at least 6 characters.";
            return;
        }

        try {
            const res = await fetch('/api/auth/reset-password-sms', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone, code, newPassword })
            });

            const data = await res.json();

            if (res.ok) {
                msg.style.color = "green";
                msg.innerText = "Password updated successfully! Redirecting to login...";
                setTimeout(() => {
                    window.location.href = "/";
                }, 2000);
            } else {
                msg.style.color = "red";
                msg.innerText = data.message || "Error updating password.";
            }
        } catch (err) {
            msg.style.color = "red";
            msg.innerText = "An unexpected error occurred.";
        }
    };
</script>
