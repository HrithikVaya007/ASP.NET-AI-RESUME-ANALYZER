@{
    ViewData["Title"] = "Forgot Password";
}

@section Styles {
    <link rel="stylesheet" href="~/css/LoginForm.css" asp-append-version="true" />
}

<div class="login-container">
    <div class="auth-wrapper">
        <div class="brand-section">
            <h1 class="brand-name">Orbit AI</h1>
            <p class="brand-tagline">Navigating your career path.</p>
        </div>

        <div class="login-form">
            <h2 class="form-title">Reset your password</h2>
            <p class="form-subtitle">
                Enter your phone number and we’ll send you a recovery code via SMS.
            </p>

            <label>
                Phone Number
                <input
                    type="tel"
                    id="phone"
                    placeholder="+1 234 567 8900"
                    required />
            </label>

            <button type="button" id="sendBtn">
                Send Reset Code
            </button>

            <div id="message" style="margin-top: 10px; text-align: center; font-size: 0.9em;"></div>

            <div class="form-footer" style="margin-top: 15px;">
                <a href="/">← Back to Login</a>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('sendBtn').onclick = async () => {
        const phone = document.getElementById('phone').value;
        const msg = document.getElementById('message');
        
        if (!phone) {
            msg.style.color = "red";
            msg.innerText = "Please enter your phone number.";
            return;
        }

        try {
            const res = await fetch('/api/auth/forgot-password-sms', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone })
            });

            const data = await res.json();

            if (res.ok) {
                msg.style.color = "green";
                msg.innerText = "Code sent! Redirecting...";
                setTimeout(() => {
                    window.location.href = `/verify-code?phone=${encodeURIComponent(phone)}`;
                }, 1500);
            } else {
                msg.style.color = "red";
                msg.innerText = data.message || "Error sending code.";
            }
        } catch (err) {
            msg.style.color = "red";
            msg.innerText = "An unexpected error occurred.";
        }
    };
</script>
